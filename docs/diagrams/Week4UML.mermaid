classDiagram
    direction TB

%% ============================================================
%% DUNGEONFORGE - COMPLETE UML CLASS DIAGRAM
%%
%% DESIGN PATTERNS:
%% 1. SIMPLE FACTORY   -> MonsterFactory
%% 2. FACTORY METHOD   -> RoomPopulator + subclasses
%% 3. ABSTRACT FACTORY -> ThemeKit + theme implementations
%% 4. SINGLETON        -> GameConfig
%% 5. SINGLETON        -> RandomSource
%% ============================================================


%% ============================================================
%% CONFIGURATION / SINGLETONS
%% ============================================================

    namespace SINGLETONS {

        class GameConfig {
            <<Singleton>>
            -static GameConfig instance
            -Map~String,Object~ settings
            -GameConfig()
            +static synchronized GameConfig getInstance() GameConfig
            -void loadDefaults()
            -void loadFromClasspath(String resourceName)
            +static String readResource(String resourceName)
            +int getInt(String key)
            +double getDouble(String key)
            +long getSeed()
            +static void resetForTest()
        }

        class RandomSource {
            <<Singleton>>
            -static RandomSource instance
            -Random rng
            -long seed
            -RandomSource()
            +static synchronized RandomSource getInstance() RandomSource
            +int nextInt(int bound)
            +int between(int lo, int hi)
            +double nextDouble()
            +T pick(List~T~ options) T
            +T pick(T[] options) T
            +long getSeed()
            +void reseed(long newSeed)
            +static void resetForTest()
        }
    }


%% ============================================================
%% CORE DOMAIN
%% ============================================================

    namespace CORE {

        class Entity {
            <<abstract>>
            #String name
            #int hp
            #int maxHp
            #int attackPower
            #int defense
            #Entity(String name, int maxHp, int attackPower, int defense)
            +String getName()
            +int getHp()
            +int getMaxHp()
            +int getAttackPower()
            +int getDefense()
            +boolean isAlive()
            +void takeDamage(int amount)
            +void heal(int amount)
            +abstract String describe()
            +String toString()
        }

        class Player {
            -int gold
            -int xp
            +Player(String name)
            +int getGold()
            +int getXp()
            +void addGold(int g)
            +void addXp(int x)
            +double carryCapacity()
            +String describe()
        }

        class Monster {
            -String species
            -int xpReward
            +Monster(String species, int baseHp, int baseAttack, int xpReward)
            +String getSpecies()
            +int getXpReward()
            +String describe()
        }

        class Room {
            -String id
            -String flavor
            -List~Monster~ monsters
            -List~Item~ floorItems
            -Chest chest
            +Room(String id)
            +String getId()
            +String getFlavor()
            +void setFlavor(String f)
            +List~Monster~ getMonsters()
            +void addMonster(Monster m)
            +List~Item~ getFloorItems()
            +void addItem(Item i)
            +Chest getChest()
            +void setChest(Chest c)
            +boolean hasChest()
        }

        class DungeonLevel {
            -int depth
            -String themeName
            -List~Room~ rooms
            +DungeonLevel(int depth, String themeName)
            +int getDepth()
            +String getThemeName()
            +List~Room~ getRooms()
            +void addRoom(Room r)
        }

        class GameWorld {
            -Player player
            -MonsterFactory monsterFactory
            -ThemeRegistry themes
            -List~DungeonLevel~ levels
            +GameWorld(Player player)
            -void generate()
            -RoomPopulator populateFor(ThemeKit theme, boolean isFinalRoom)
            +Player getPlayer()
            +List~DungeonLevel~ getLevels()
            +MonsterFactory getMonsterFactory()
            +ThemeRegistry getThemes()
            +int totalMonsters()
        }
    }


%% ============================================================
%% SIMPLE FACTORY
%% ============================================================

    namespace SIMPLE_FACTORY {

class MonsterFactory {
<<Simple Factory>>
-Map~String,MonsterDef~ blueprints
+MonsterFactory()
-void loadFrom(String resourceName)
+void register(MonsterDef def)
+Monster create(String id, int depth)
+List~String~ idsForTheme(String name)
+String bossIdFromTheme(String name)
+boolean has(String id)
+int blueprintCount()
-static String str(Object o, String fallback)
-static int num(Object o, int fallback)
}

class MonsterDef {
-String id
-String name
-int hp
-int attack
-int xp
-String theme
-boolean boss
+MonsterDef(String id, String name, int hp, int attack, int xp, String theme)
+MonsterDef(String id, String name, int hp, int attack, int xp, String theme, boolean boss)
+String getId()
+String getName()
+int getHp()
+int getAttack()
+int getXp()
+String getTheme()
+boolean isBoss()
+String toString()
}
}


%% ============================================================
%% FACTORY METHOD
%% ============================================================

namespace FACTORY_METHOD {

class RoomPopulator {
<<abstract>>
<<Factory Method>>
#ThemeKit theme
#RoomPopulator(ThemeKit theme)
+final void populate(Room room, int depth)
#abstract List~Monster~ createEncounter(int depth)
#Chest createChest(int depth)
+abstract String kind()
}

class StandardRoomPopulator {
<<Concrete Creator>>
+StandardRoomPopulator(ThemeKit theme)
+String kind()
#List~Monster~ createEncounter(int depth)
}

class TreasureRoomPopulator {
<<Concrete Creator>>
+TreasureRoomPopulator(ThemeKit theme)
+String kind()
#List~Monster~ createEncounter(int depth)
#Chest createChest(int depth)
}

class BossRoomPopulator {
<<Concrete Creator>>
+BossRoomPopulator(ThemeKit theme)
+String kind()
#List~Monster~ createEncounter(int depth)
#Chest createChest(int depth)
}
}


%% ============================================================
%% ABSTRACT FACTORY
%% ============================================================

namespace ABSTRACT_FACTORY {

class ThemeKit {
<<interface>>
<<Abstract Factory>>
+String themeName()
+Monster createMonster(int depth)
+Monster createBoss(int depth)
+Item createLoot(int depth)
+String createRoomFlavor()
}

class CryptThemeKit {
<<Concrete Factory>>
-MonsterFactory factory
-String[] FLAVORS
+CryptThemeKit(MonsterFactory factory)
+String themeName()
+Monster createMonster(int depth)
+Monster createBoss(int depth)
+Item createLoot(int depth)
+String createRoomFlavor()
}

class ForgeThemeKit {
<<Concrete Factory>>
-MonsterFactory factory
-String[] FLAVORS
+ForgeThemeKit(MonsterFactory factory)
+String themeName()
+Monster createMonster(int depth)
+Monster createBoss(int depth)
+Item createLoot(int depth)
+String createRoomFlavor()
}

class FrostThemeKit {
<<Concrete Factory>>
-MonsterFactory factory
-String[] FLAVORS
+FrostThemeKit(MonsterFactory factory)
+String themeName()
+Monster createMonster(int depth)
+Monster createBoss(int depth)
+Item createLoot(int depth)
+String createRoomFlavor()
}

class TheGladeThemeKit {
<<Concrete Factory>>
-MonsterFactory factory
-String[] FLAVORS
+TheGladeThemeKit(MonsterFactory factory)
+String themeName()
+Monster createMonster(int depth)
+Monster createBoss(int depth)
+Item createLoot(int depth)
+String createRoomFlavor()
}

class ThemeRegistry {
-List~ThemeKit~ kits
+ThemeRegistry(MonsterFactory factory)
+ThemeKit forDepth(int depth)
+int size()
+List~String~ themeName()
}
}


%% ============================================================
%% ITEMS
%% ============================================================

namespace ITEMS {

class Item {
<<interface>>
+String getName()
+double getWeight()
+int getValue()
+String describe()
}

class Weapon {
-String name
-double weight
-int value
-int damage
+Weapon(String name, double weight, int value, int damage)
+String getName()
+double getWeight()
+int getValue()
+int getDamage()
+String describe()
}

class Armor {
-String name
-double weight
-int value
-int defense
+Armor(String name, double weight, int value, int defense)
+String getName()
+double getWeight()
+int getValue()
+int getDefense()
+String describe()
}

class Potion {
-String name
-double weight
-int value
-int healAmount
+Potion(String name, double weight, int value, int healAmount)
+String getName()
+double getWeight()
+int getValue()
+int getHealAmount()
+String describe()
}

class Treasure {
-String name
-double weight
-int value
+Treasure(String name, double weight, int value)
+String getName()
+double getWeight()
+int getValue()
}

class Chest {
-String name
-List~Item~ contents
+Chest(String name)
+String getName()
+List~Item~ getContents()
+void add(Item item)
+boolean isEmpty()
+int totalValue()
}
}


%% ============================================================
%% CONFIG / JSON
%% ============================================================

namespace CONFIG {

class Json {
<<utility>>
-String s
-int i
-Json(String s)
+static Map~String,Object~ parseObject(String text)
-void ws()
-Object value()
-Map~String,Object~ object()
-List~Object~ array()
-String string()
-Double number()
}
}


%% ============================================================
%% APPLICATION
%% ============================================================

namespace APPLICATION {

class Main {
<<Application Entry Point>>
+static String VERSION
-Main()
+static String banner()
+static void main(String[] args)
}
}


%% ============================================================
%% INHERITANCE
%% ============================================================

Entity <|-- Player
Entity <|-- Monster

RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator

ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. TheGladeThemeKit

Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure


%% ============================================================
%% CORE COMPOSITION / AGGREGATION
%% ============================================================

GameWorld --> Player : owns
GameWorld *-- DungeonLevel : contains
DungeonLevel *-- Room : contains
Room *-- Monster : contains
Room o-- Item : floor items
Room o-- Chest : optional chest

Chest *-- Item : contains


%% ============================================================
%% SIMPLE FACTORY RELATIONSHIPS
%% ============================================================

MonsterFactory --> MonsterDef : stores blueprints
MonsterFactory ..> Monster : creates
MonsterFactory ..> RandomSource : uses
MonsterFactory ..> GameConfig : reads resources
MonsterFactory ..> Json : parses JSON

MonsterDef ..> Monster : blueprint for


%% ============================================================
%% FACTORY METHOD RELATIONSHIPS
%% ============================================================

RoomPopulator --> ThemeKit : uses
RoomPopulator ..> Room : populates
RoomPopulator ..> Monster : creates encounter
RoomPopulator ..> Chest : creates chest

StandardRoomPopulator ..> GameConfig : reads limits
StandardRoomPopulator ..> RandomSource : uses randomness

TreasureRoomPopulator ..> RandomSource : selects loot count
TreasureRoomPopulator ..> Chest : creates

BossRoomPopulator ..> Chest : creates


%% ============================================================
%% ABSTRACT FACTORY RELATIONSHIPS
%% ============================================================

ThemeRegistry *-- ThemeKit : manages

CryptThemeKit --> MonsterFactory : delegates monster creation
ForgeThemeKit --> MonsterFactory : delegates monster creation
FrostThemeKit --> MonsterFactory : delegates monster creation
TheGladeThemeKit --> MonsterFactory : delegates monster creation

CryptThemeKit ..> Monster : produces
CryptThemeKit ..> Item : produces

ForgeThemeKit ..> Monster : produces
ForgeThemeKit ..> Item : produces

FrostThemeKit ..> Monster : produces
FrostThemeKit ..> Item : produces

TheGladeThemeKit ..> Monster : produces
TheGladeThemeKit ..> Item : produces


%% ============================================================
%% SINGLETON RELATIONSHIPS
%% ============================================================

GameConfig ..> Json : parses config
RandomSource ..> GameConfig : gets seed

GameWorld ..> GameConfig : getInstance()
GameWorld ..> RandomSource : getInstance()

Player ..> GameConfig : getInstance()
Monster ..> RandomSource : getInstance()

CryptThemeKit ..> RandomSource : getInstance()
ForgeThemeKit ..> RandomSource : getInstance()
FrostThemeKit ..> RandomSource : getInstance()
TheGladeThemeKit ..> RandomSource : getInstance()

TreasureRoomPopulator ..> RandomSource : getInstance()
StandardRoomPopulator ..> RandomSource : getInstance()
BossRoomPopulator ..> RandomSource : getInstance()


%% ============================================================
%% GAMEWORLD FACTORY METHOD SELECTION
%% ============================================================

GameWorld ..> RoomPopulator : selects creator
GameWorld ..> StandardRoomPopulator : creates
GameWorld ..> TreasureRoomPopulator : creates
GameWorld ..> BossRoomPopulator : creates
GameWorld ..> ThemeRegistry : selects theme


%% ============================================================
%% MAIN APPLICATION RELATIONSHIPS
%% ============================================================

Main ..> GameConfig : accesses Singleton
Main ..> RandomSource : accesses Singleton
Main ..> Player : creates
Main ..> GameWorld : creates
Main ..> DungeonLevel : reads
Main ..> Room : reads
Main ..> Monster : reads


%% ============================================================
%% PATTERN STYLING
%% ============================================================

classDef singleton fill:#e8d5ff,stroke:#7b2cbf,stroke-width:3px,color:#000
classDef simpleFactory fill:#ffd6a5,stroke:#e76f00,stroke-width:3px,color:#000
classDef factoryMethod fill:#bde0fe,stroke:#0077b6,stroke-width:3px,color:#000
classDef abstractFactory fill:#caffbf,stroke:#2d6a4f,stroke-width:3px,color:#000
classDef concreteFactory fill:#e2f0cb,stroke:#40916c,stroke-width:2px,color:#000
classDef core fill:#f5f5f5,stroke:#555,stroke-width:1px,color:#000
classDef item fill:#fff3cd,stroke:#b08900,stroke-width:1px,color:#000
classDef utility fill:#eeeeee,stroke:#777,stroke-width:1px,color:#000
classDef application fill:#d9d9d9,stroke:#333,stroke-width:2px,color:#000

